# Copy this file to .env and fill in the values you need.

# Hugging Face model settings
HF_TOKEN=your-hugging-face-token
HF_MODEL_REPO=your-account/moralization-xlm-roberta
HF_INFERENCE_ENDPOINT_URL=https://your-endpoint.region.aws.endpoints.huggingface.cloud
HF_SCALE_UP_TIMEOUT=300
HF_REQUEST_TIMEOUT_SECONDS=360
HF_MORALIZATION_LABEL=moralization
HF_NON_MORALIZATION_LABEL=no_moralization
LEMMAS_DIR=/absolute/path/to/models/dimi
ENABLED_LANGUAGES=de,en,fr

# Billing / credit system
DATABASE_PATH=/absolute/path/to/backend/data/billing.sqlite3
FREE_TIER_DAILY_CREDITS=20
MAX_BATCH_INSTANCES=200000
MAX_INPUT_TEXT_LENGTH=5000
MAX_UPLOAD_BYTES=<redacted>
RATE_LIMIT_REQUESTS=<redacted>
RATE_LIMIT_WINDOW_SECONDS=<redacted>
EXTERNAL_REQUEST_CREDIT_COST=1
LOCAL_REQUEST_CREDIT_COST=0
ADMIN_API_KEY=choose-a-long-random-admin-secret

# OpenAI settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Reserved for the Claude branch
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
