# Copy this file to .env and fill in the values you need.

# Local model settings
MODEL_DIR=/absolute/path/to/models/FacebookAI-xlm-roberta-base-finetuned-base_params/checkpoint-1473
LEMMAS_DIR=/absolute/path/to/models/dimi

# Billing / credit system
DATABASE_PATH=/absolute/path/to/backend/data/billing.sqlite3
FREE_TIER_DAILY_CREDITS=5
MAX_BATCH_INSTANCES=200000
MAX_INPUT_TEXT_LENGTH=5000
EXTERNAL_REQUEST_CREDIT_COST=1
ADMIN_API_KEY=choose-a-long-random-admin-secret

# OpenAI settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Reserved for the Claude branch
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
